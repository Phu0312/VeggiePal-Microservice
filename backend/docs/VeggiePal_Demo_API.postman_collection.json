            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"title\": \"Chia sẻ món ăn ngon\",\n  \"content\": \"Món ăn này rất hợp khi ăn kèm với thịt bò và hải sản tươi ngon...\",\n  \"publish\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/blogs",
              "host": ["{{baseUrl}}"],
              "path": ["blogs"]
            }
          }
        },
        {
          "name": "Admin View Moderation Queue (FR-12)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/moderation/queue?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "moderation", "queue"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
