            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 7,\n  \"title\": \"Bí quyết nấu phở nấm ngọt lịm từ rau củ\",\n  \"content\": \"Sử dụng mía lau và củ cải trắng ninh chậm 1 tiếng sẽ cho nước dùng ngọt thanh tuyệt vời...\",\n  \"publish\": true\n}"
