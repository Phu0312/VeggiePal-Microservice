{
  "info": {
    "_postman_id": "c040e82b-veggiepal-demo-collection-v1",
    "name": "VeggiePal Backend - Lecturer Demo Collection",
    "description": "Bộ sưu tập Postman đầy đủ cho buổi báo cáo Đồ Án Tốt Nghiệp, kiểm thử toàn bộ 12 yêu cầu chức năng (FR-01 đến FR-12) qua API Gateway (Port 18080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080/api",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "guestId",
      "value": "demo-device-guest-101",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication & Users (FR-01 & FR-10)",
      "item": [
        {
          "name": "Login as User (Auto-sets userToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.result && jsonData.result.token) {",
                  "    pm.collectionVariables.set('userToken', jsonData.result.token);",
                  "    console.log('Set userToken successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@veggiepal.com\",\n  \"password\": \"Demo@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"]
            }
          }
        },
        {
          "name": "Login as Admin (Auto-sets adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.result && jsonData.result.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.result.token);",
                  "    console.log('Set adminToken successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@veggiepal.com\",\n  \"password\": \"Demo@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Admin List Users (FR-10)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            }
          }
        },
        {
          "name": "Admin Update User Status (FR-10)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/3/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "3", "status"]
            }
          }
        }
      ]
    },
